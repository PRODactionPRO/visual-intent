{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visual-intent.dev/schema/visual-task-0.1.json",
  "title": "Visual Intent Task",
  "type": "object",
  "required": [
    "protocolVersion",
    "id",
    "surface",
    "nodes",
    "regions",
    "frames",
    "relations",
    "annotations",
    "intent",
    "status",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "protocolVersion": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "displayNumber": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["code-change", "figma-component"] },
    "surface": { "$ref": "#/$defs/surface" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "attachments": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/attachment" }
    },
    "intent": { "$ref": "#/$defs/intent" },
    "repository": { "$ref": "#/$defs/repository" },
    "batchId": { "type": "string", "minLength": 1 },
    "iterationId": { "type": "string", "minLength": 1 },
    "rootTaskId": { "type": "string", "minLength": 1 },
    "previousTaskId": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 1, "default": 1 },
    "review": { "$ref": "#/$defs/taskReview" },
    "rating": { "$ref": "#/$defs/taskRating" },
    "status": {
      "enum": [
        "draft",
        "ready",
        "queued",
        "in_progress",
        "needs_input",
        "applied",
        "rejected"
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "result": { "$ref": "#/$defs/result" }
  },
  "anyOf": [
    {
      "required": ["kind"],
      "properties": { "kind": { "const": "figma-component" } }
    },
    {
      "properties": {
        "intent": {
          "properties": {
            "instruction": { "type": "string", "pattern": "\\S" }
          }
        }
      }
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["root", "name"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "required": ["id", "platform", "uri", "adapter"],
      "properties": {
        "id": { "type": "string" },
        "platform": {
          "enum": ["web", "react-native", "ios", "android", "canvas"]
        },
        "uri": { "type": "string" },
        "title": { "type": "string" },
        "viewport": {
          "type": "object",
          "required": ["width", "height", "devicePixelRatio"],
          "properties": {
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 },
            "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "adapter": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "surfaceId", "kind"],
      "properties": {
        "id": { "type": "string" },
        "surfaceId": { "type": "string" },
        "kind": {
          "enum": ["element", "component", "view", "layer", "virtual"]
        },
        "name": { "type": "string" },
        "stableSelector": { "type": "string" },
        "text": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "id",
        "surfaceId",
        "x",
        "y",
        "width",
        "height",
        "scrollX",
        "scrollY",
        "scale"
      ],
      "properties": {
        "id": { "type": "string" },
        "surfaceId": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "scrollX": { "type": "number" },
        "scrollY": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "surfaceId",
        "frameId",
        "x",
        "y",
        "width",
        "height",
        "unit",
        "coordinateSpace"
      ],
      "properties": {
        "id": { "type": "string" },
        "surfaceId": { "type": "string" },
        "frameId": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["px", "normalized"] },
        "coordinateSpace": { "enum": ["viewport", "surface", "node"] }
      }
    },
    "entityRef": {
      "type": "object",
      "required": ["entity", "id"],
      "properties": {
        "entity": {
          "enum": ["surface", "node", "region", "frame", "annotation"]
        },
        "id": { "type": "string" }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["contains", "targets", "anchors", "precedes", "relates-to"]
        },
        "from": { "$ref": "#/$defs/entityRef" },
        "to": { "$ref": "#/$defs/entityRef" }
      }
    },
    "annotation": {
      "type": "object",
      "required": ["id", "kind", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["comment", "highlight", "drawing", "measurement"] },
        "body": { "type": "string" },
        "nodeId": { "type": "string" },
        "regionId": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "attachment": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "mimeType",
        "fileName",
        "byteSize",
        "sha256",
        "path",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["screenshot", "file"] },
        "mimeType": { "type": "string", "minLength": 1 },
        "fileName": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "path": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "intent": {
      "type": "object",
      "required": ["id", "action", "instruction", "acceptanceCriteria"],
      "properties": {
        "id": { "type": "string" },
        "action": { "enum": ["change", "review", "question", "bug"] },
        "instruction": { "type": "string" },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object",
      "required": ["summary", "changedFiles", "notes"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "batchChangedFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preExistingDirtyFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "classification": { "$ref": "#/$defs/taskClassification" }
      }
    },
    "taskClassification": {
      "type": "object",
      "required": ["categories", "scale"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "style",
              "layout",
              "text",
              "behavior",
              "bug",
              "image",
              "figma",
              "unknown"
            ]
          }
        },
        "scale": {
          "enum": [
            "element",
            "region",
            "screen",
            "multi-screen",
            "system",
            "unknown"
          ]
        }
      },
      "if": {
        "properties": {
          "categories": { "contains": { "const": "unknown" } }
        },
        "required": ["categories"]
      },
      "then": {
        "properties": { "categories": { "maxItems": 1 } }
      }
    },
    "taskReview": {
      "type": "object",
      "required": ["outcome", "reviewedAt"],
      "properties": {
        "outcome": {
          "enum": ["accepted", "needs_revision", "not_accepted"]
        },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 1 },
        "followUpTaskId": { "type": "string", "minLength": 1 }
      }
    },
    "taskRating": {
      "type": "object",
      "required": ["value", "ratedAt"],
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "ratedAt": { "type": "string", "format": "date-time" }
      }
    },
    "agentTaskResult": {
      "type": "object",
      "required": [
        "taskId",
        "status",
        "summary",
        "changedFiles",
        "notes",
        "classification"
      ],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "needs_input", "failed"] },
        "summary": { "type": "string", "minLength": 1 },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "classification": { "$ref": "#/$defs/taskClassification" }
      }
    },
    "tokenUsage": {
      "type": "object",
      "required": [
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningOutputTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "openAiApiPricingSnapshot": {
      "type": "object",
      "required": [
        "id",
        "capturedAt",
        "sourceUrl",
        "currency",
        "serviceTier",
        "contextTierAssumption",
        "inputUsdPerMillion",
        "cachedInputUsdPerMillion",
        "cacheWriteInputUsdPerMillion",
        "outputUsdPerMillion"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "currency": { "const": "USD" },
        "serviceTier": { "const": "standard" },
        "contextTierAssumption": {
          "const": "up-to-272k-input-per-request"
        },
        "inputUsdPerMillion": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d{1,6})?$"
        },
        "cachedInputUsdPerMillion": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d{1,6})?$"
        },
        "cacheWriteInputUsdPerMillion": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d{1,6})?$"
        },
        "outputUsdPerMillion": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d{1,6})?$"
        },
        "promotionalThrough": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "apiEquivalentCost": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "availability",
            "kind",
            "scope",
            "model",
            "amountUsd",
            "billableTokens",
            "pricingSnapshot",
            "reasoningIncludedInOutput",
            "estimateBasis"
          ],
          "properties": {
            "availability": { "const": "calculated" },
            "kind": { "const": "openai-api-equivalent" },
            "scope": { "const": "apply-batch-turn" },
            "model": { "type": "string", "minLength": 1 },
            "reasoningPolicy": { "type": "string", "minLength": 1 },
            "amountUsd": {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d{1,9})?$"
            },
            "billableTokens": {
              "type": "object",
              "required": [
                "uncachedInputTokens",
                "cachedInputTokens",
                "cacheWriteInputTokens",
                "outputTokens"
              ],
              "properties": {
                "uncachedInputTokens": { "type": "integer", "minimum": 0 },
                "cachedInputTokens": { "type": "integer", "minimum": 0 },
                "cacheWriteInputTokens": { "type": "integer", "minimum": 0 },
                "outputTokens": { "type": "integer", "minimum": 0 }
              }
            },
            "pricingSnapshot": {
              "$ref": "#/$defs/openAiApiPricingSnapshot"
            },
            "reasoningIncludedInOutput": { "const": true },
            "estimateBasis": { "const": "aggregate-turn-short-context" }
          }
        },
        {
          "type": "object",
          "required": ["availability", "reason"],
          "properties": {
            "availability": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "batchUsage": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "availability",
            "capture",
            "source",
            "scope",
            "exact",
            "tokens"
          ],
          "properties": {
            "availability": { "const": "reported" },
            "capture": { "enum": ["direct", "host-reported"] },
            "provider": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "scope": { "const": "apply-batch-turn" },
            "exact": { "const": true },
            "tokens": { "$ref": "#/$defs/tokenUsage" },
            "model": { "type": "string", "minLength": 1 },
            "reasoningPolicy": { "type": "string", "minLength": 1 },
            "adapterVersion": { "type": "string", "minLength": 1 },
            "apiEquivalentCost": {
              "$ref": "#/$defs/apiEquivalentCost"
            }
          }
        },
        {
          "type": "object",
          "required": ["availability", "reason"],
          "properties": {
            "availability": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "observedOperations": {
      "type": "object",
      "required": [
        "completeness",
        "sdkTurns",
        "commandExecutions",
        "mcpToolCalls",
        "webSearches",
        "fileChangeOperations",
        "failedOperations",
        "uniqueChangedPaths"
      ],
      "properties": {
        "completeness": { "enum": ["complete", "partial"] },
        "sdkTurns": { "type": "integer", "minimum": 0 },
        "commandExecutions": { "type": "integer", "minimum": 0 },
        "mcpToolCalls": { "type": "integer", "minimum": 0 },
        "webSearches": { "type": "integer", "minimum": 0 },
        "fileChangeOperations": { "type": "integer", "minimum": 0 },
        "failedOperations": { "type": "integer", "minimum": 0 },
        "uniqueChangedPaths": { "type": "integer", "minimum": 0 }
      }
    },
    "batchResult": {
      "type": "object",
      "required": ["summary", "changedFiles", "notes"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "batchChangedFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preExistingDirtyFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "technicalDetails": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "failureCode": { "type": "string", "minLength": 1 },
        "executionId": { "type": "string", "minLength": 1 },
        "taskResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentTaskResult" }
        },
        "usage": { "$ref": "#/$defs/batchUsage" },
        "observedOperations": { "$ref": "#/$defs/observedOperations" }
      }
    },
    "projectController": {
      "type": "object",
      "required": ["kind", "threadId", "source", "attachedAt"],
      "properties": {
        "kind": { "const": "codex" },
        "threadId": { "type": "string", "minLength": 1 },
        "source": { "enum": ["cli", "plugin", "generated"] },
        "attachedAt": { "type": "string", "format": "date-time" }
      }
    },
    "projectContextSnapshot": {
      "type": "object",
      "required": ["revision", "content", "capturedAt"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "content": { "type": "string", "minLength": 1, "maxLength": 24000 },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "batchContinuation": {
      "type": "object",
      "required": ["answer", "answeredAt"],
      "properties": {
        "answer": { "type": "string", "pattern": "\\S", "maxLength": 12000 },
        "answeredAt": { "type": "string", "format": "date-time" }
      }
    },
    "batchClaim": {
      "type": "object",
      "required": ["id", "attempt", "executorOwnership", "claimedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "executorOwnership": {
          "enum": ["host-attached", "visual-intent-owned"]
        },
        "executorThreadId": { "type": "string", "minLength": 1 },
        "controllerThreadId": { "type": "string", "minLength": 1 },
        "claimedAt": { "type": "string", "format": "date-time" }
      }
    },
    "applyBatch": {
      "type": "object",
      "required": [
        "id",
        "sessionId",
        "taskIds",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "taskIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "attempt": { "type": "integer", "minimum": 1, "default": 1 },
        "status": {
          "enum": [
            "waiting_for_executor",
            "queued",
            "in_progress",
            "needs_input",
            "completed",
            "failed"
          ]
        },
        "executorOwnership": {
          "enum": ["host-attached", "visual-intent-owned"]
        },
        "executorThreadId": { "type": "string", "minLength": 1 },
        "claim": { "$ref": "#/$defs/batchClaim" },
        "projectContext": { "$ref": "#/$defs/projectContextSnapshot" },
        "continuation": { "$ref": "#/$defs/batchContinuation" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "result": { "$ref": "#/$defs/batchResult" }
      }
    },
    "reviewTask": {
      "type": "object",
      "required": ["expectedRevision", "outcome"],
      "properties": {
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "outcome": {
          "enum": ["accepted", "needs_revision", "not_accepted"]
        },
        "note": { "type": "string", "minLength": 1 },
        "revision": {
          "type": "object",
          "required": ["instruction"],
          "properties": {
            "instruction": { "type": "string", "pattern": "\\S" },
            "attachments": {
              "type": "array",
              "maxItems": 3,
              "items": { "$ref": "#/$defs/attachment" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "needs_revision" } },
            "required": ["outcome"]
          },
          "then": { "required": ["revision"] },
          "else": { "not": { "required": ["revision"] } }
        }
      ]
    },
    "visualIntentEvent": {
      "type": "object",
      "required": ["schemaVersion", "id", "type", "occurredAt", "actor"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "task.created",
            "task.updated",
            "task.deleted",
            "task.reviewed",
            "task.rated",
            "task.revision_created",
            "batch.dispatched",
            "batch.claimed",
            "batch.retried",
            "batch.finished"
          ]
        },
        "occurredAt": { "type": "string", "format": "date-time" },
        "actor": { "enum": ["user", "visual-intent", "agent"] },
        "sessionId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "iterationId": { "type": "string", "minLength": 1 },
        "round": { "type": "integer", "minimum": 1 },
        "batchId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "data": { "type": "object" }
      }
    },
    "executionRecord": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "sessionId",
        "batchId",
        "attempt",
        "taskIds",
        "provider",
        "adapter",
        "status",
        "startedAt",
        "completedAt",
        "durationMs",
        "usage",
        "taskResults"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "batchId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "taskIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "executorOwnership": {
          "enum": ["host-attached", "visual-intent-owned"]
        },
        "executorThreadId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningPolicy": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "needs_input", "failed"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/batchUsage" },
        "observedOperations": { "$ref": "#/$defs/observedOperations" },
        "taskResults": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/agentTaskResult" }
        }
      }
    }
  }
}
