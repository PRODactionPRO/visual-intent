{
  "name": "visual-intent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual feedback bridge between running interfaces and coding agents.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo": "pnpm build && concurrently --kill-others-on-fail --names app,visual-intent \"pnpm dev:example\" \"pnpm dev:proxy\"",
    "dev:example": "pnpm --filter @visual-intent/example-web dev --host 127.0.0.1 --port 5173",
    "dev:proxy": "node apps/cli/dist/index.js start --target http://127.0.0.1:5173 --port 7310",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "vip": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "concurrently": "10.0.5",
    "eslint": "10.0.0",
    "prettier": "3.6.2",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
